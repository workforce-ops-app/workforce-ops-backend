# Copy to .env for local use: `copy .env.example .env` (Windows) or `cp .env.example .env`.
# .env is never committed. Every setting the backend reads is listed here with a
# safe example value; real secrets are never given defaults in code.

# Which environment this is: development, test, or production.
APP_ENV=development

# Log level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# Database connection for the application's database user (decision 0034: PyMySQL),
# used by tools on your computer (the API run with uvicorn, the seed script). Port 3307 keeps it
# apart from XAMPP's database on 3306. No password in the URL: it goes in
# DATABASE_PASSWORD below, so any characters work in it.
DATABASE_URL=mysql+pymysql://workforce_app@localhost:3307/workforce_ops
# The password for DATABASE_URL; must match MYSQL_APP_PASSWORD.
DATABASE_PASSWORD=change-me-locally

# The migrations user (#43), used only by Alembic on your computer (`alembic upgrade
# head`); the only user that may change the structure. The application user above can
# only read and write data. Docker Compose's migrate tool sets its own copy.
MIGRATIONS_DATABASE_URL=mysql+pymysql://workforce_migrations@localhost:3307/workforce_ops
# The password for MIGRATIONS_DATABASE_URL; must match MYSQL_MIGRATIONS_PASSWORD.
MIGRATIONS_DATABASE_PASSWORD=change-me-migrations-locally

# The secret key that signs the audit log (docs/architecture/audit-log.md), at least 32
# characters, and its ID. Generate your own with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never share or commit it. Without a key, any action that writes an audit entry fails.
# AUDIT_SIGNING_KEY=
AUDIT_KEY_ID=local-1

# The secret key behind CSRF tokens (docs/architecture/authentication.md), at least 32
# characters, different from the audit key. The API does not start without it. Generate
# your own the same way as the audit key.
# CSRF_KEY=
# The application's address as the browser sees it. Requests that change something must
# come from it. Leave unset when running the API directly (uvicorn); Docker Compose sets it
# to the frontend's address, http://localhost:8080.
# APP_ORIGIN=http://localhost:8080

# Passwords Docker Compose gives MySQL when it creates the database (first start only;
# changing them later needs a database reset, see the contributor docs). Pick your own.
MYSQL_ROOT_PASSWORD=change-me-root-locally
MYSQL_APP_PASSWORD=change-me-locally
MYSQL_MIGRATIONS_PASSWORD=change-me-migrations-locally

# The password the demo seed script gives every demo account (python -m scripts.seed_demo),
# so you can sign in as any of them. At least 15 characters and not a common password,
# e.g. a few words with spaces. Leave it unset and the demo accounts have no password.
# DEMO_PASSWORD=a few words with spaces
